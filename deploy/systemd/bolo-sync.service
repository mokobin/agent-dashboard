[Unit]
Description=BOLO HQ Sync API (agent heartbeats + SSE)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=boloku
Group=boloku
EnvironmentFile=/etc/boloku/sync.env
# Needs Python >= 3.9. deploy/install.sh rewrites this line to the interpreter it detected
# (default on the BOLO VPS: python3.11 — system python3 there is 3.6.8).
ExecStart=/usr/bin/python3.11 -u /opt/boloku/server/app.py
WorkingDirectory=/opt/boloku/server
Restart=always
RestartSec=2

# hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/boloku
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=128M
TasksMax=300

[Install]
WantedBy=multi-user.target
