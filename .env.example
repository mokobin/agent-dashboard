# Sync API
SYNC_API_HOST=127.0.0.1
SYNC_API_PORT=8001
SYNC_DATA_FILE=server/data/status.json
# Per-agent tokens, format: agent_id:token,agent_id:token
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, the API runs in DEV mode (any heartbeat accepted) — do not use in production.
AGENT_TOKENS=
