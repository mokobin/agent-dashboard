# Copy to /etc/boloku/sync.env (NOT into the repo). Generate real values with:
#   python3 server/gen-tokens.py /etc/boloku/sync.env
BOLO_TOKENS=bolo_airdrop:CHANGE_ME,bolongonten:CHANGE_ME,hunter-2:CHANGE_ME,mas-wowo:CHANGE_ME,mas-wiwi:CHANGE_ME
BOLO_ADMIN_TOKEN=CHANGE_ME
BOLO_HOST=127.0.0.1
BOLO_PORT=8787
BOLO_DB=/var/lib/boloku/state.db
BOLO_OFFLINE_AFTER=60
# BOLO_CORS_ORIGIN=*          # only for local dev across origins
# BOLO_STATIC_DIR=/opt/boloku/pwa   # only if running without nginx
